server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /api/apuestas/ {
        proxy_pass         http://apuestas-service:8005/api/apuestas/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
    }

    location /api/bonos/ {
        proxy_pass         http://bonos-service:8004/api/bonos/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
    }

    location /api/estadisticas/ {
        proxy_pass         http://estadisticas-service:8006/api/estadisticas/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
    }

    location /api/ {
        proxy_pass         http://${BACKEND_HOST}:3000/api/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    location /health {
        proxy_pass http://${BACKEND_HOST}:3000/health;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}